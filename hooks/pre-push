#!/bin/sh
# hooks/pre-push — W1-T3059. THE ROUTES REFUSE; THEY NO LONGER ONLY SUGGEST.
#
# WHY THIS EXISTS. Three checks shipped recently — the census-membership verb, rule15-precheck, and
# the ratchet contract — and every one of them is UNENFORCED PROSE: a worker learns of them only by
# reading a contract line it is free to skip. CLAUDE.md's own header says exactly what that is worth:
# a rule stated only in prose "can be violated silently and repeatedly, which is why several of these
# bullets exist at all". The measured case is the census family — a suite WALKS a population and names
# none of a caller's symbols, so the mandated `git grep -l <symbol>` sweep is structurally blind to it
# (four such CI failures across #4283/#4290, none found by a correctly-run sweep). A check the author
# must remember is a check that fails exactly when the author is busy.
#
# WHY A HOOK IS CHEAP NOW AND WAS NOT. W1-T221 weighed this route and deferred it, recording that
# "this repo currently ships no git hooks at all ... so the hook route carries install machinery this
# task would also owe". That is now STALE: hooks/commit-msg and hooks/pre-commit ship, and spawnWorker
# sets `core.hooksPath=hooks` on every worker worktree it creates. The install path this route owed is
# already built and paid for; this file is picked up with no new machinery at all.
#
# WHICH IS ALSO THE BLAST RADIUS, so it SHIPPED OFF FIRST. Being picked up automatically by every
# worker means a mistake here does not redden one PR, it stops the fleet pushing. W1-T3059 shipped
# it with the switch defaulting OFF, on purpose, and W1-T3222 is the separate, watched decision that
# flips that default: seven PRs reddened by ONE untiered file each in two days is what the switch was
# withholding, MEASURED. The switch is still the whole safety story and is deliberately the first
# thing that runs, but the direction is now FAIL-ARMED: only the exact string "0" disarms. Unset,
# empty, or any other value runs every check below — a stray `export RMD_PREPUSH_GATES=yes` must not
# silently turn the fleet's gates off, which is the mirror of the old hazard (a stray value could not
# arm it either). The documented escape hatch stays: `RMD_PREPUSH_GATES=0 git push ...`.
set -u

# W1-T3224 — SCRUB GIT'S PER-INVOCATION ENVIRONMENT BEFORE ANY SUBPROCESS RUNS.
#
# git exports GIT_DIR (and friends) to every hook, and every child inherits them. A child that
# runs `git -C <somewhere-else>` then resolves to THIS repo instead of the directory it named.
# OBSERVED 2026-09-09 on a real armed push: the census suites this hook runs build git fixtures
# that way, and one push rewrote the pushing lane's HEAD to a fixture commit and cut its index
# from 3,550 tracked files to 1 — seven fixture commits from a single run.
#
# THE WHOLE FAMILY, not just GIT_DIR: GIT_INDEX_FILE alone redirects a child's staging, and each
# of the others redirects a different part of the same machinery. Unsetting one reads as complete
# and is not.
#
# THE HOOK STILL FINDS ITS OWN REPO: with these unset, git discovers the repository from the
# working directory, which for a pre-push hook is the worktree root. VERIFIED on a linked
# worktree (branch and origin/main both resolve), which is the case that matters because every
# fleet lane is one.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_NAMESPACE GIT_QUARANTINE_PATH

# W1-T3222: ARMED BY DEFAULT. The scrub above runs FIRST and unconditionally — it protects every
# child this hook spawns, and a hook that exits before spawning any still costs nothing to have
# scrubbed. Only the literal "0" disarms: `core.hooksPath=hooks` puts this file in every worker
# worktree, so a loose truthiness test would let a stray value turn the fleet's gates off.
[ "${RMD_PREPUSH_GATES:-}" = "0" ] && exit 0

# W1-T6120 — EVERY SCRIPT BELOW RUNS FROM THIS HOOK'S OWN CODE ROOT, never from the tree being pushed.
# The push leaf runs the HARNESS's copy of this file with the worker worktree as cwd, so a relative
# `scripts/x.mjs` (or `--import tsx`, or the cwd's tsconfig) would run the code the worker wrote, as the
# daemon. The cwd is DATA: each check reads it as the repository it judges. When this file is the tree's
# own hook (a worker or an operator pushing their checkout), the two roots coincide and nothing changes.
gate_root="$(CDPATH='' cd -- "$(dirname -- "$0")/.." 2>/dev/null && pwd -P)"
tree_root="$(pwd -P)"
tsx_loader="$gate_root/node_modules/tsx/dist/loader.mjs"
if [ ! -f "$tsx_loader" ]; then
  tsx_loader=""
  echo "pre-push: no tsx loader under $gate_root — each loader-run check below reads absent: skipped, NOT passed" >&2
fi
[ -f "$gate_root/tsconfig.json" ] && export TSX_TSCONFIG_PATH="$gate_root/tsconfig.json"
export RMD_GATE_ROOT="$gate_root"
# A check whose QUESTION is the tree's own code (its census suites, its package.json lint argv, its
# capability generator) runs only when the tree is the gate root; from the harness it is skipped by name.
own_tree=0
[ "$gate_root" = "$tree_root" ] && own_tree=1
# A loader-run check with no loader under the gate root could only exit 1, which reads as a violation.
has() { [ -f "$gate_root/scripts/$1" ] && { [ "${2:-}" != tsx ] || [ -n "$tsx_loader" ]; }; }

fail=0

# A CHECK THAT COULD NOT RUN IS NOT A CHECK THAT PASSED — AND IT IS NOT A VIOLATION EITHER. All
# checks below are skipped-with-a-name when their entry point is absent, and the prechecks' own exit
# 2 (an unreadable diff) is honoured as unreadable. Blocking a push because a check was missing
# would be this repo's recurring defect: a bound that fires on a healthy condition.
if has rule15-precheck.mjs tsx; then
  # VIA THE LOADER, like every other entry point here: the script imports `src/lib/review.js`, a
  # path that exists only under tsx, so a bare `node` exits 1 with ERR_MODULE_NOT_FOUND — which the
  # exit-code arms below would have read as a rule-15 VIOLATION. A check that cannot run must not be
  # able to masquerade as a check that failed; package.json's own `rule15-precheck` alias is tsx.
  node --import "$tsx_loader" "$gate_root/scripts/rule15-precheck.mjs"
  rc=$?
  if [ "$rc" -eq 2 ]; then
    echo "pre-push: rule15-precheck could not read the diff — not blocking on an unreadable check" >&2
  elif [ "$rc" -ne 0 ]; then
    fail=1
  fi
else
  echo "pre-push: scripts/rule15-precheck.mjs absent — skipped, NOT passed" >&2
fi

# W1-T3072 — ask the reviewer's exact Rule 25 question while the diff is still local. This is
# separate from rule15: one prevents a plan criterion riding with implementation, the other keeps
# measurement instruments from riding with the product they judge.
if has rule25-precheck.mjs tsx; then
  node --import "$tsx_loader" "$gate_root/scripts/rule25-precheck.mjs"
  rc=$?
  if [ "$rc" -eq 2 ]; then
    echo "pre-push: rule25-precheck could not read the diff — not blocking on an unreadable check" >&2
  elif [ "$rc" -ne 0 ]; then
    fail=1
  fi
else
  echo "pre-push: scripts/rule25-precheck.mjs absent — skipped, NOT passed" >&2
fi

# W1-T3423 — a CI control-plane edit can be mechanically incomplete while its only existing
# detectors run after the push. This static route reads only the local merge-base diff and tracked
# control-plane inputs; status 2 is an unreadable local fact, not permission to strand the fleet.
if has ci-control-plane-precheck.mjs tsx; then
  if [ "$own_tree" -eq 1 ]; then
    node --import "$tsx_loader" "$gate_root/scripts/ci-control-plane-precheck.mjs"
  else
    # Its capability arm spawns the TREE's generator, so a diff reaching it is skipped by name (exit 4).
    node --import "$tsx_loader" -e '
      const { pathToFileURL } = require("node:url");
      const at = (p) => import(pathToFileURL(process.env.RMD_GATE_ROOT + p).href);
      Promise.all([at("/scripts/ci-control-plane-precheck.mjs"), at("/scripts/lib/git.mjs")]).then(([m, g]) => {
        let files;
        try { files = g.gitOrThrow(["diff", "--name-only", "origin/main...HEAD"]).split("\n").filter(Boolean); }
        catch (e) { console.error(String(e.message ?? e)); process.exit(2); }
        if (m.affectedCapabilitySnapshot(files)) {
          console.error("pre-push: ci-control-plane-precheck — this diff moves a capability-snapshot input, whose check runs the branch\x27s own generator; the host gate runs no worktree code: skipped, NOT passed (CI runs it)");
          process.exit(4);
        }
        process.exit(m.runCiControlPlanePrecheck({ readChangedFiles: () => files }));
      }, () => process.exit(2));
    '
  fi
  rc=$?
  if [ "$rc" -eq 4 ]; then
    :
  elif [ "$rc" -eq 2 ]; then
    echo "pre-push: ci-control-plane-precheck could not read the diff — not blocking on an unreadable check" >&2
  elif [ "$rc" -ne 0 ]; then
    fail=1
  fi
else
  echo "pre-push: scripts/ci-control-plane-precheck.mjs absent — skipped, NOT passed" >&2
fi

# W1-T3205: BEGIN test-tier admission
# Refuse before push, but never mutate the duration ledger from a gate.
if has test-tier-manifest.mjs; then
  # W1-T4430 — WHAT THIS REFUSES FLIPPED. A new test file with no manifest row is the fast tier
  # and is ADMITTED (no row is ever seeded for it); the check now refuses only a GHOST row, one that
  # names a test file no longer on disk, and names the fix ("remove the row, or restore the file").
  # `--base` is still passed so this stays CI's exact invocation, though the ghost check does not
  # need it: a stale row is stale whichever commit introduced it.
  node "$gate_root/scripts/test-tier-manifest.mjs" --check --base origin/main || fail=1
else
  echo "pre-push: scripts/test-tier-manifest.mjs absent — skipped, NOT passed" >&2
fi
# W1-T3205: END test-tier admission

# W1-T3225 — THE CENSUS STEP IS GONE, AND ITS ABSENCE IS THE POINT.
#
# This hook used to spawn the test runner over every census suite `rmd census-membership` could
# place for the diff. The invocation is spelled out in W1-T3225 rather than quoted here: a suite
# asserting this hook spawns no runner would otherwise match its own explanatory comment, which
# is the same trap clock-signature-census sets for a comment naming the clock call it avoids. MEASURED over nine pre-push incidents across two days (#4749 #4750 #4751 #4760
# #4761, and #4698 #4692 #4681 #4684 from W1-T3205's filing), every one was a single UNTIERED TEST
# FILE — which the tier admission above names in about two seconds, spawning nothing. The census
# step caught NONE of them. It also reported clearing 9 suites while naming 125 it could not place.
#
# What it did do, twice on 2026-09-09, was damage the repository it was protecting: one armed push
# rewrote the pushing lane's HEAD to a test fixture's commit and cut its index from 3,550 tracked
# files to 1, and another re-initialised the SHARED gitdir as bare, taking the main checkout and
# the daemon down. W1-T3224's env scrub fixes that MECHANISM and stays; this task answers the
# separate question of whether a git hook should spawn a test runner at all.
#
# THE COVERAGE DOES NOT MOVE: every census suite runs in CI's ci-shard, unchanged. This changes
# WHEN a small subset runs, never WHETHER any of them do. `rmd census-membership` keeps its verb
# and its purpose as a report an author can run by hand.

# BEGIN census precheck — the census QUESTIONS, without the runner W1-T3225 removed.
# Three suites (clock-signature, comment-load, fixture-copy) cost a CI round each in one session,
# because a census names none of a caller's symbols. scripts/census-precheck.mjs imports each one's
# own counter, reads files and spawns only read-only git. It blocks only growth this branch causes
# against origin/main's merge base; a census main already fails is not this push's to answer for.
if has census-precheck.mjs; then
  if [ "$own_tree" -eq 1 ]; then
    node "$gate_root/scripts/census-precheck.mjs" --base origin/main
  else
    # The counts run from the gate root over this tree as data, against the GATE ROOT's admission table;
    # a census suite to run is this tree's own test file, so it reads NOT MEASURED instead (exit 2).
    node -e '
      const { pathToFileURL } = require("node:url");
      import(pathToFileURL(process.env.RMD_GATE_ROOT + "/scripts/census-precheck.mjs").href).then((m) => {
        const runSuites = () => { throw new Error("they are the branch\x27s own test files and the host gate runs no worktree code (CI runs them)"); };
        process.exitCode = m.main(["--base", "origin/main"], { admitted: () => m.listAdmittedCensusMembers(process.env.RMD_GATE_ROOT), runSuites });
      }, (e) => { console.error(String(e?.message ?? e)); process.exitCode = 2; });
    '
  fi
  rc=$?
  if [ "$rc" -eq 2 ]; then
    echo "pre-push: census-precheck could not measure — not blocking on an unreadable check" >&2
  elif [ "$rc" -ne 0 ]; then
    fail=1
  fi
else
  echo "pre-push: scripts/census-precheck.mjs absent — skipped, NOT passed" >&2
fi
# END census precheck

# BEGIN lint-plan precheck (W1-T4901) — the plan lint CI runs on a changed shard, asked before the push.
# MEASURED 2026-09-16..30: 14 of 55 single-shard test reds were the PR's own shard failing `lint-plan:fast`. The script
# spawns that npm script's argv (offline, no test runner), abstains on a stale origin/main, and reports a
# machine-filing-admission-only finding without blocking.
if [ "$own_tree" -ne 1 ] && has lint-plan-precheck.mjs; then
  echo "pre-push: lint-plan-precheck runs the branch's own package.json lint argv; the host gate runs no worktree code: skipped, NOT passed (CI runs it)" >&2
elif has lint-plan-precheck.mjs; then
  node "$gate_root/scripts/lint-plan-precheck.mjs" --base origin/main
  rc=$?
  if [ "$rc" -eq 2 ]; then
    echo "pre-push: lint-plan-precheck could not run the lint — not blocking on an unreadable check" >&2
  elif [ "$rc" -ne 0 ]; then
    fail=1
  fi
else
  echo "pre-push: scripts/lint-plan-precheck.mjs absent — skipped, NOT passed" >&2
fi
# END lint-plan precheck

# W1-T3388 — BEGIN head-identity admission (ADVISORY)
# MEASURED 2026-09-16: head-identity-gate is a REQUIRED check that no local route ran, so two PRs
# opened within an hour (#5737, #5739) each burned a full CI round discovering it and then needed a
# trailer-only repair commit. It is deterministic, needs no network, and already ships a local
# entrypoint — every ingredient for naming it here instead of after a red board.
#
# ADVISORY, NOT BLOCKING, AND THAT IS THE DESIGN. An ad-hoc PR cites its own number
# (`Remudero-Task: PR-<n>`), which does not exist until the PR does — so the FIRST push of such a
# branch cannot satisfy the gate, and refusing it would make the ad-hoc route impossible rather
# than early. This hook also reaches every worker worktree via core.hooksPath, where a wrong
# refusal does not redden one PR, it stops the fleet pushing. So it reports and never sets `fail`.
#
# THE REF IS THE ONE BEING PUSHED, NOT THE CHECKED-OUT BRANCH. git hands pre-push
# "<local ref> <local sha> <remote ref> <remote sha>" per line on stdin, and the gate judges the
# REMOTE name: `git push origin HEAD:run-W1-T3618-...` carries a local branch that is not what the
# PR will show. stdin is unused everywhere else in this hook, so consuming it here costs nothing;
# when it is empty — run by hand, or by this repo's own tests — fall back to the checked-out branch.
head_ref=""
head_sha=""
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/*) head_ref="${remote_ref#refs/heads/}"; head_sha="$_local_sha"; break ;;
  esac
done
if [ -z "$head_ref" ]; then
  head_ref="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
fi
if [ -z "$head_sha" ]; then
  head_sha="HEAD"
fi
if has head-identity-gate.mjs tsx; then
  if [ -n "$head_ref" ] && [ "$head_ref" != "HEAD" ]; then
    if ! node --import "$tsx_loader" "$gate_root/scripts/head-identity-gate.mjs" --head-ref "$head_ref"; then
      echo "pre-push: head-identity-gate would REFUSE this head in CI — advisory here, so the push" >&2
      echo "pre-push: continues. Fix it before CI does: add an anchored \`Remudero-Task: <id>\` trailer" >&2
      echo "pre-push: to the head commit, or push a \`run-<taskId>-<epochMs>\` branch." >&2
    fi
  else
    echo "pre-push: head-identity-gate — no pushable ref resolved, skipped, NOT passed" >&2
  fi
else
  echo "pre-push: scripts/head-identity-gate.mjs absent — skipped, NOT passed" >&2
fi
# W1-T3388 — END head-identity admission

# W1-T4214 — BEGIN head-identity TRANSITION (BLOCKING, and only this narrow case)
# The advisory above prints and the push goes on, and nobody reads it: a push that took #6562's head
# from admitted to refused was the incident, and the only repair left was a new pull request. What is
# refused here is NOT "this head is unidentified" (a first push of an ad-hoc branch legitimately is) but
# the TRANSITION: the remote tip is admitted by head-identity-gate's own predicate and the head being
# pushed is not, and the refusal names the identity form the remote tip had. A new branch (all-zero
# remote sha), a deletion, a remote tip this clone does not hold, or an unreadable message is not a
# transition — each is named as skipped, never counted as cleared, and never blocks. The ref is the
# SAME remote ref on both sides, so a ref-shaped identity can never be lost here; what can be is a trailer.
# Both messages are read exactly as the gate reads one (--first-parent --no-merges).
zero_sha="0000000000000000000000000000000000000000"
if has head-identity-gate.mjs tsx && [ -n "$head_ref" ] && [ -n "${_remote_sha:-}" ] \
   && [ "$_remote_sha" != "$zero_sha" ] && [ "${_local_sha:-}" != "$zero_sha" ] && [ "$head_sha" != "HEAD" ]; then
  if git cat-file -e "${_remote_sha}^{commit}" 2>/dev/null; then
    RMD_IDT_REF="$head_ref" \
    RMD_IDT_OLD="$(git log -1 --first-parent --no-merges --format=%B "$_remote_sha" 2>/dev/null)" \
    RMD_IDT_NEW="$(git log -1 --first-parent --no-merges --format=%B "$head_sha" 2>/dev/null)" \
    node --import "$tsx_loader" -e '
      const { pathToFileURL } = require("node:url");
      import(pathToFileURL(process.env.RMD_GATE_ROOT + "/scripts/head-identity-gate.mjs").href).then((gate) => {
        const { RMD_IDT_REF: headRef, RMD_IDT_OLD: oldMsg, RMD_IDT_NEW: newMsg } = process.env;
        if (!oldMsg || !newMsg) process.exit(2);
        const was = gate.evaluateHeadIdentityGate({ headCommitMessage: oldMsg, headRef });
        const now = gate.evaluateHeadIdentityGate({ headCommitMessage: newMsg, headRef });
        if (was.ok && !now.ok) { console.error("identity LOST — the remote tip was " + was.message); process.exit(3); }
        process.exit(0);
      }, () => process.exit(2));
    '
    rc=$?
    # EXIT 3 IS THE ONLY REFUSAL: a loader or import crash exits 1 and must not read as a violation.
    if [ "$rc" -eq 3 ]; then
      echo "pre-push: REFUSED — this push turns an admitted head into one head-identity-gate REFUSES." >&2
      echo "pre-push: Add the anchored \`Remudero-Task: <id>\` trailer back to the head commit; the same" >&2
      echo "pre-push: branch can be pushed again, no new pull request needed." >&2
      fail=1
    elif [ "$rc" -ne 0 ]; then
      echo "pre-push: head-identity transition could not be judged — not blocking on an unreadable check" >&2
    fi
  else
    echo "pre-push: head-identity transition — remote tip not in this clone, skipped, NOT passed" >&2
  fi
fi
# W1-T4214 — END head-identity TRANSITION

# A plan-only shard on its own run branch would create false implementation credit at merge.
# This narrow check runs before the first push, when the branch can still be renamed. An
# unreadable base, diff or shard is unknown, not a reason to strand fleet work.
if has worker-branch-shape.mjs; then
  node "$gate_root/scripts/worker-branch-shape.mjs" --self-credit-only --base origin/main --head-ref "$head_ref" --head-sha "$head_sha"
  rc=$?
  if [ "$rc" -eq 2 ]; then
    echo "pre-push: worker-branch-shape could not read local evidence — not blocking" >&2
  elif [ "$rc" -ne 0 ]; then
    fail=1
  fi
else
  echo "pre-push: scripts/worker-branch-shape.mjs absent — skipped, NOT passed" >&2
fi

# BEGIN proof-resolve precheck (2026-09-29) — the reviewer's certain proof refusals, asked before the push.
# MEASURED 2026-09-15..29: 14 of 40 reviewer-unmet fix rounds were a `unit test:` title no test carried. The script
# reuses the reviewer's own resolver, spawns no test runner, blocks only on a title miss, and reports a grep miss.
if has proof-resolve-precheck.mjs tsx; then
  node --import "$tsx_loader" "$gate_root/scripts/proof-resolve-precheck.mjs" --base origin/main --head-ref "${head_ref:-}"
  rc=$?
  if [ "$rc" -eq 2 ]; then
    echo "pre-push: proof-resolve-precheck could not read this head — not blocking on an unreadable check" >&2
  elif [ "$rc" -ne 0 ]; then
    fail=1
  fi
else
  echo "pre-push: scripts/proof-resolve-precheck.mjs absent — skipped, NOT passed" >&2
fi
# END proof-resolve precheck

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "pre-push REFUSED. These are checks CI runs on this diff; fixing them here costs one" >&2
  echo "local run, and fixing them after the push costs a red PR and a review cycle." >&2
  echo "" >&2
  echo "To push anyway (an emergency, and it will be judged on the PR):" >&2
  echo "  RMD_PREPUSH_GATES=0 git push ..." >&2
  exit 1
fi

exit 0
