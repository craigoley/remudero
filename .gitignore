node_modules
local/
*.pat
FINDINGS-local*

# build output
dist/
*.tsbuildinfo

# generated coverage reports (W1-T25 coverage-ratchet gate consumes coverage/lcov.info,
# regenerated fresh every run — never committed)
coverage/

# generated mutation-testing reports (W1-T96 mutation-ratchet gate consumes
# reports/mutation/mutation.json, regenerated fresh every run — never committed) + Stryker's
# own scratch sandbox directory
reports/mutation/
.stryker-tmp/
.stryker-tmp-*/
.stryker-plan/

# Stryker's incremental-mode cache (W1-T108: restored/saved by ci.yml's mutation-ratchet job
# via actions/cache, never committed — a stale local copy must never be mistaken for CI's)
reports/stryker-incremental.json

# os / editor
.DS_Store
# W1-T2633: never legitimate repo content, and nothing refused them at any layer before this.
.idea/
.vscode/

# runtime exhaust (W1-T256): the daemon/serve write these into their OWN working tree every run —
# pure append-only/derived state (the ledger, status/marker caches, the clarification-question
# backlog, launchd's stdout/stderr logs), never committed. Un-ignored they read as "dirt" in a
# `git status --porcelain`, which (pre-W1-T255) crash-looped the daemon on restart; ignored, this
# exhaust never counts against a clean tree.
state/
plan/questions.ndjson
plan/operator-notes.ndjson
# impl-EP: agent scratch that has landed in the canonical checkout. Four bytes of this was on its own
# enough to disable auto-sync (self-sync.ts's dirty check is unscoped) and to count toward the 107
# deploy aborts. NAMED EXACTLY, never a *.json glob — that would mask package-lock.json and be worse
# than the disease.
ee-open.json
# Claude Code's own per-project state directory. Untracked since 2026-08-03 and never committable;
# on its own it made `git status --porcelain` non-empty, which is all self-sync's dirty check reads.
# `.claude/*` (not `.claude/`) ON PURPOSE — a directory-match pattern makes a later `!` negation
# a no-op (git never re-descends into an excluded directory), so this must exclude by content to
# leave the one exception below re-includable.
.claude/*
# W1-T1066: the ONE exception. settings/worker.json's PreToolUse deny floor reaches spawned
# workers only (settingSources: [] isolates them from every other settings source); an
# interactive `claude` lane — the lane that actually polled `gh` in a loop and locked the
# operator out of his own repo for ~90 minutes — loads a repo-level .claude/settings.json
# natively, and that is the only surface that reaches it. Un-ignoring exactly this one path
# makes the same deny floor reach interactive lanes too; everything else under .claude/ stays
# ignored, so no operator-local state (transcripts, session caches) becomes committable by
# accident.
!.claude/settings.json
# W1-T2763: the SECOND exception, and the same mechanism. `.claude/skills/<name>/SKILL.md` is
# GENERATED from settings/macros.yaml and byte-compared by `macro-skills:check`, so it has to be
# tracked or the gate compares against nothing and passes vacuously. Un-ignoring the DIRECTORY is
# what makes the files inside re-includable at all — git never re-descends into an excluded
# directory, which is why the `.claude/*` form above exists. Operator-local state (transcripts,
# session caches) stays ignored exactly as before: this un-ignores one generated tree, not `.claude/`.
!.claude/skills/
*.log

# W1-T421: mutated module copies written by test/helpers/mutant-module.ts. They live under test/
# rather than os.tmpdir() ON PURPOSE — a copy outside the project root re-enters the real src/lib
# graph and destroys the coverage record of unrelated modules. writeMutantModule removes them on
# process exit; this entry is the backstop for a run killed outright, so a crashed suite cannot
# leave dirt that self-sync's unscoped dirty check reads as a reason to stop deploying.
test/mutants-*/
