#!/usr/bin/env bash
# rmd — Remudero CLI (proto-runner era). Thin wrapper; all logic lives in TS.
#
# The full, authoritative command list lives in ONE place — the COMMANDS registry in
# src/run-task.ts — not here. Run `rmd --help` for every command, or `rmd <cmd> --help`
# for one (both generated from that registry, W1-T47). This header used to hand-duplicate
# that list in prose and had already drifted from what main() actually dispatched
# (missing dep-review/sweep/fix, stale flags on drain/daemon) — exactly the failure mode
# a single source of truth is meant to prevent. Do not re-add a duplicate list here.
set -euo pipefail
# Resolve the real package root even when invoked through symlinks (npm link /
# a global install both put `rmd` on PATH as a symlink chain, not a copy).
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$LINK_DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# R-49 (docs/audits/recon-2026-09-05.md): `.nvmrc`, package.json#engines and deploy/Dockerfile all
# pin an exact Node version, but `npm ci` only WARNS (EBADENGINE) on a mismatch and lets a stale
# install through — the only thing that actually refuses today is a random test failure
# (scripts/coverage-merge-ratchet.mjs's assertPinnedNodeVersion) far from where an operator could
# act on it. The operator ruled against `engine-strict` in .npmrc (it would refuse `npm ci` on
# every off-pin machine, agent containers included), so this warns and CONTINUES — never refuses.
# bash-3.2-safe: no associative arrays, no `[[ =~ ]]`, no arrays at all.
if [ -f "$DIR/.nvmrc" ]; then
  RMD_EXPECTED_NODE="$(cat "$DIR/.nvmrc")"
  RMD_EXPECTED_NODE="${RMD_EXPECTED_NODE#v}"
  RMD_ACTUAL_NODE="$(node --version 2>/dev/null || true)"
  RMD_ACTUAL_NODE="${RMD_ACTUAL_NODE#v}"
  if [ -n "$RMD_ACTUAL_NODE" ] && [ "$RMD_ACTUAL_NODE" != "$RMD_EXPECTED_NODE" ]; then
    echo "rmd: node $RMD_ACTUAL_NODE differs from the pinned $RMD_EXPECTED_NODE in .nvmrc; see rmd doctor" >&2
  fi
  unset RMD_EXPECTED_NODE RMD_ACTUAL_NODE
fi

exec "$DIR/node_modules/.bin/tsx" "$DIR/src/run-task.ts" "$@"
