#!/usr/bin/env bash
# rmd — Remudero CLI (proto-runner era). Thin wrapper; all logic lives in TS.
#
# The full, authoritative command list lives in ONE place — the COMMANDS registry in
# src/run-task.ts — not here. Run `rmd --help` for every command, or `rmd <cmd> --help`
# for one (both generated from that registry, W1-T47). This header used to hand-duplicate
# that list in prose and had already drifted from what main() actually dispatched
# (missing dep-review/sweep/fix, stale flags on drain/daemon) — exactly the failure mode
# a single source of truth is meant to prevent. Do not re-add a duplicate list here.
set -euo pipefail
# Resolve the real package root even when invoked through symlinks (npm link /
# a global install both put `rmd` on PATH as a symlink chain, not a copy).
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$LINK_DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# R-49 (docs/audits/recon-2026-09-05.md): `.nvmrc`, package.json#engines and deploy/Dockerfile all
# pin an exact Node version, but `npm ci` only WARNS (EBADENGINE) on a mismatch and lets a stale
# install through — the only thing that actually refuses today is a random test failure
# (scripts/coverage-merge-ratchet.mjs's assertPinnedNodeVersion) far from where an operator could
# act on it. The operator ruled against `engine-strict` in .npmrc (it would refuse `npm ci` on
# every off-pin machine, agent containers included), so this warns and CONTINUES — never refuses.
# bash-3.2-safe: no associative arrays, no `[[ =~ ]]`, no arrays at all.
if [ -f "$DIR/.nvmrc" ]; then
  RMD_EXPECTED_NODE="$(cat "$DIR/.nvmrc")"
  RMD_EXPECTED_NODE="${RMD_EXPECTED_NODE#v}"
  RMD_ACTUAL_NODE="$(node --version 2>/dev/null || true)"
  RMD_ACTUAL_NODE="${RMD_ACTUAL_NODE#v}"
  if [ -n "$RMD_ACTUAL_NODE" ] && [ "$RMD_ACTUAL_NODE" != "$RMD_EXPECTED_NODE" ]; then
    echo "rmd: node $RMD_ACTUAL_NODE differs from the pinned $RMD_EXPECTED_NODE in .nvmrc; see rmd doctor" >&2
  fi
  unset RMD_EXPECTED_NODE RMD_ACTUAL_NODE
fi

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "help" ]; then
  exec node "$DIR/scripts/rmd-help.mjs"
fi

if [ "${1:-}" = "daemon" ]; then
  # W1-T9106 (ADR 0007 decision C): the daemon verb starts under the heap ceiling the daemon learned, in place of the
  # inherited --max-old-space-size, when <config root>/state/daemon-heap-ceiling.json is applied and current for this
  # instance. Plain node, no tsx: the same rule as launchHeapCeiling (src/lib/daemon-memory-policy.ts), which the daemon
  # re-reads to name ceiling_source. Absent, stale, shadow or unreadable prints nothing and the inherited value stays.
  RMD_LEARNED_NODE_OPTIONS="$(node -e '
const fs = require("fs"), path = require("path"), home = require("os").homedir();
let root;
try { root = JSON.parse(fs.readFileSync(path.join(home, ".config", "remudero", "config.json"), "utf8")).root; } catch (e) { root = ""; }
const dir = path.join(typeof root === "string" && root !== "" ? root : path.join(home, "Remudero"), "state");
const r = JSON.parse(fs.readFileSync(path.join(dir, "daemon-heap-ceiling.json"), "utf8")), mib = r && r.ceiling_mib;
if (!r || r.version !== 1 || r.state_dir !== dir || !(Date.now() < r.valid_until) || r.mode !== "applied" || !Number.isInteger(mib) || mib < 256) process.exit(1);
const words = (process.env.NODE_OPTIONS || "").split(/\s+/).filter(Boolean), kept = [];
for (let i = 0; i < words.length; i++) {
  const m = /^--max[-_]old[-_]space[-_]size(=.*)?$/.exec(words[i]);
  if (!m) kept.push(words[i]);
  else if (m[1] === undefined && /^\d+$/.test(words[i + 1] || "")) i++;
}
kept.push("--max-old-space-size=" + mib);
process.stdout.write(kept.join(" "));
' 2>/dev/null || true)"
  if [ -n "$RMD_LEARNED_NODE_OPTIONS" ]; then
    export NODE_OPTIONS="$RMD_LEARNED_NODE_OPTIONS"
  fi
  unset RMD_LEARNED_NODE_OPTIONS
  RMD_MAIN_CHOICE="$(node "$DIR/scripts/build-child-entries.mjs" --root "$DIR" --main-entry "$1" 2>/dev/null || true)"
  RMD_MAIN_KIND="$(printf '%s' "$RMD_MAIN_CHOICE" | cut -f1)"
  RMD_MAIN_REASON="$(printf '%s' "$RMD_MAIN_CHOICE" | cut -f2)"
  RMD_MAIN_BUNDLE="$(printf '%s' "$RMD_MAIN_CHOICE" | cut -f3)"
  if [ "$RMD_MAIN_KIND" = "bundle" ] && [ -f "$RMD_MAIN_BUNDLE" ]; then
    export RMD_MAIN_ENTRY="bundle:$RMD_MAIN_REASON"
    exec node --enable-source-maps "$RMD_MAIN_BUNDLE" "$@"
  fi
  export RMD_MAIN_ENTRY="tsx:${RMD_MAIN_REASON:-resolver-gave-no-answer}"
  unset RMD_MAIN_CHOICE RMD_MAIN_KIND RMD_MAIN_REASON RMD_MAIN_BUNDLE
fi

exec "$DIR/node_modules/.bin/tsx" "$DIR/src/run-task.ts" "$@"
