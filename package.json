{
  "name": "remudero",
  "version": "0.1.0",
  "description": "Plan-stewarding orchestration harness for Claude Code and Codex",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "rmd": "bin/rmd"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "files": [
    "bin",
    "src",
    "settings",
    "hooks",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node scripts/check.mjs",
    "test": "node --test --import tsx --import ./test/setup/tmp-hygiene.ts \"test/**/*.test.ts\"",
    "test:ci": "node scripts/test-with-retry.mjs node --test --import tsx --import ./test/setup/tmp-hygiene.ts \"test/**/*.test.ts\"",
    "test:tier:check": "node scripts/test-tier-manifest.mjs --check",
    "test:fast": "node scripts/test-tier-manifest.mjs --run fast",
    "test:slow": "node scripts/test-tier-manifest.mjs --run slow",
    "lint-plan": "tsx src/run-task.ts lint-plan",
    "lint-plan:offline": "node --import tsx scripts/lint-plan-offline.mjs",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "cycle-ratchet": "node scripts/cycle-ratchet.mjs",
    "jscpd": "jscpd src scripts --config .jscpd.json",
    "claims": "node scripts/claims-check.mjs",
    "assertion-discrimination": "node scripts/assertion-discrimination-check.mjs",
    "learnings-index": "node scripts/generate-learnings-index.mjs",
    "learnings-index:check": "node scripts/generate-learnings-index.mjs --check",
    "plan-index": "node scripts/generate-plan-index.mjs",
    "plan-index:check": "node scripts/generate-plan-index.mjs --check",
    "docs-index": "node scripts/generate-docs-index.mjs",
    "docs-index:check": "node scripts/generate-docs-index.mjs --check",
    "docs-index:check-paths": "node scripts/generate-docs-index.mjs --check-paths",
    "api-client:generate": "node scripts/generate-api-client.mjs",
    "api-client:check": "node scripts/generate-api-client.mjs --check",
    "no-hand-rolled-fetch:check": "node scripts/no-hand-rolled-fetch-check.mjs",
    "unwired-gate:check": "node scripts/unwired-gate-check.mjs",
    "coverage-session-blanking:check": "node scripts/coverage-session-blanking-check.mjs",
    "mkdtemp-callsite-check": "node scripts/mkdtemp-callsite-check.mjs",
    "task-id-existence:check": "node scripts/task-id-existence-check.mjs --base origin/main",
    "learnings-assert": "node scripts/learnings-assert-check.mjs",
    "learnings-assert:check": "node scripts/learnings-assert-check.mjs --check",
    "cli-reference": "tsx scripts/generate-cli-reference.mjs",
    "rule15-precheck": "tsx scripts/rule15-precheck.mjs",
    "cli-reference:check": "tsx scripts/generate-cli-reference.mjs --check",
    "proof-dialect": "tsx scripts/generate-proof-dialect.mjs",
    "macro-skills": "node --import tsx scripts/generate-macro-skills.mjs",
    "macro-skills:check": "node --import tsx scripts/generate-macro-skills.mjs --check",
    "capability-snapshot": "tsx scripts/generate-capability-snapshot.mjs",
    "capability-snapshot:check": "tsx scripts/generate-capability-snapshot.mjs --check",
    "spike": "tsx src/spike.ts",
    "learnings-budget-ratchet": "node scripts/learnings-budget-ratchet.mjs",
    "claude-md-budget-ratchet": "node scripts/claude-md-budget-ratchet.mjs",
    "source-size-signal": "node scripts/source-size-ratchet.mjs",
    "source-size-ratchet": "node scripts/source-size-ratchet.mjs",
    "source-size-baseline:legacy": "node scripts/source-size-ratchet.mjs --baseline scripts/source-size-baseline.json",
  "comment-load-ratchet": "node scripts/comment-load-ratchet.mjs",
  "build:console": "npm --prefix apps/dashboard run build",
    "comment-load-signal": "node scripts/comment-load-ratchet.mjs --no-record",
  "comment-load": "node scripts/comment-load-ratchet.mjs --print",
    "console-parity": "node --import tsx scripts/console-parity-ratchet.mjs",
    "census:bound-kind": "node --test --import tsx --import ./test/setup/tmp-hygiene.ts test/bound-kind-declared.test.ts",
    "census:ledger-literal": "node --test --import tsx --import ./test/setup/tmp-hygiene.ts test/ledger-literal-census.test.ts",
    "census:catch-erasure": "node --test --import tsx --import ./test/setup/tmp-hygiene.ts test/catch-erasure-ratchet.test.ts",
    "census:negative-reachability": "node --test --import tsx --import ./test/setup/tmp-hygiene.ts test/negative-reachability-ratchet.test.ts",
    "census:no-shallowing": "node --test --import tsx --import ./test/setup/tmp-hygiene.ts test/no-shallowing-of-the-canonical-checkout.test.ts",
    "census:wall-clock-bound": "node --test --import tsx --import ./test/setup/tmp-hygiene.ts test/a-wall-clock-bound-declares-itself.test.ts",
    "census:authority": "node --test --import tsx --import ./test/setup/tmp-hygiene.ts test/authority-ratchet.test.ts",
    "worker-branch-shape:check": "node scripts/worker-branch-shape.mjs",
    "commitlint": "commitlint",
    "changelog": "commit-and-tag-version"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@stryker-mutator/core": "^9.6.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^22.20.1",
    "commit-and-tag-version": "^13.1.2",
    "dependency-cruiser": "^18.2.0",
    "fast-check": "^4.9.0",
    "jscpd": "^5.1.2"
  },
  "_dependencyRationale": {
    "@swc/core": "Required by .dependency-cruiser.cjs parser: \"swc\"; src never imports it, but depcruise loads it for TypeScript 7 extraction.",
    "playwright": "Runtime dependency for rmd review's browser proof path; src/lib/review.ts resolves node_modules/playwright/cli.js to install Chromium."
  },
  "overrides": {
    "qs": "^6.16.0",
    "js-yaml": "^4.3.2"
  },
  "_overridesRationale": {
    "qs": "Forces typed-rest-client's qs 6.15.1 pin and Express/body-parser qs ranges to 6.16.0, patched for GHSA-4mjr-xmp4-gh2g and GHSA-x5fp-wj9c-mxmx.",
    "js-yaml": "Forces cosmiconfig's js-yaml 4.3.1, reached only through @commitlint/cli, to 4.3.2 — patched for GHSA-2883-xcg3-v3hh (maxTotalMergeKeys does not bound CPU on empty merge keys). Dev-scope, and no direct dependency declares js-yaml, so an override is the only lever short of waiting on cosmiconfig."
  },
  "commit-and-tag-version": {
    "skip": {
      "commit": true,
      "tag": true
    }
  }
}
