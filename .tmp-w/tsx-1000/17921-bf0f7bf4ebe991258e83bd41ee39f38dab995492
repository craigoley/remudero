{"code":"import assert from\"node:assert/strict\";import{readFileSync}from\"node:fs\";import{test}from\"node:test\";import{fileURLToPath}from\"node:url\";import{COMMANDS,HANDLERS,USAGE,commandHelp}from\"../src/run-task.js\";const runTaskSrc=readFileSync(fileURLToPath(new URL(\"../src/run-task.ts\",import.meta.url)),\"utf8\");test(\"USAGE is generated FROM COMMANDS \\u2014 every registry entry's syntax + summary line appears verbatim\",()=>{for(const spec of COMMANDS){assert.ok(USAGE.includes(spec.syntax),`USAGE is missing the ${spec.name} registry entry's syntax \\u2014 it must be generated from COMMANDS, not hand-duplicated`);assert.ok(USAGE.includes(spec.summary),`USAGE is missing the ${spec.name} registry entry's summary \\u2014 the top level must print a summary, not the full detail`)}});test(\"USAGE has no stray command lines beyond COMMANDS \\u2014 same count of 'rmd <name>' lines as registry entries\",()=>{const usageCommandLines=USAGE.split(\"\\n\").filter(line=>/^  rmd /.test(line));assert.equal(usageCommandLines.length,COMMANDS.length,\"USAGE line count must match COMMANDS.length exactly \\u2014 a mismatch means USAGE has a line the registry doesn't (or vice versa)\")});test(\"commandHelp(spec) prints exactly that command's syntax + full detail \\u2014 no other command's text leaks in\",()=>{for(const spec of COMMANDS){const help=commandHelp(spec);assert.ok(help.includes(spec.syntax),`commandHelp for ${spec.name} must include its own syntax`);assert.ok(help.includes(spec.detail),`commandHelp for ${spec.name} must include its own full detail`);const others=COMMANDS.filter(c=>c.name!==spec.name);for(const other of others){assert.notEqual(other.syntax,spec.syntax)}}});test(\"every COMMANDS entry has a matching HANDLERS entry \\u2014 the registry can't silently drift from what's actually dispatched\",()=>{const missing=COMMANDS.map(spec=>spec.name).filter(name=>!HANDLERS.has(name));assert.deepEqual(missing,[],`COMMANDS lists these verbs but HANDLERS has no entry for them (undispatchable \\u2014 buildRegistry would already throw at module load): ${JSON.stringify(missing)}`)});test(\"HELP-COVERAGE (the reverse direction): every HANDLERS entry has a COMMANDS entry \\u2014 no live, undocumented verb\",()=>{const registered=new Set(COMMANDS.map(c=>c.name));const undocumented=[...HANDLERS.keys()].filter(name=>!registered.has(name));assert.deepEqual(undocumented,[],`verb(s) dispatched via HANDLERS but MISSING a COMMANDS entry (undocumented in rmd --help / rmd <cmd> --help): ${JSON.stringify(undocumented)} \\u2014 add each to COMMANDS in src/run-task.ts`)});test(\"HANDLERS and COMMANDS name exactly the same number of verbs \\u2014 a fast sanity check the two directions above aren't each silently vacuous\",()=>{assert.equal(HANDLERS.size,COMMANDS.length,\"HANDLERS.size must equal COMMANDS.length\")});test(\"`rmd <cmd> --help` is checked BEFORE any verb's business-logic dispatch, so it never spawns a side effect (e.g. `rmd notify --help` must not send a notification)\",()=>{const helpCheckIdx=runTaskSrc.indexOf(\"COMMANDS.find((c) => c.name === cmd)\");const dispatchIdx=runTaskSrc.indexOf(\"await dispatchCommand(cmd, rest, REGISTRY, USAGE)\");assert.ok(helpCheckIdx>=0,\"main() must look up the command spec for per-command help\");assert.ok(dispatchIdx>=0,\"main() must still call dispatchCommand for its business-logic dispatch\");assert.ok(helpCheckIdx<dispatchIdx,\"the --help intercept must run before the registry dispatch call\")});\n","warnings":[],"map":{"version":3,"mappings":"AAAA,OAAO,WAAY,qBACnB,OAAS,iBAAoB,UAC7B,OAAS,SAAY,YACrB,OAAS,kBAAqB,WAC9B,OAAS,SAAU,SAAU,MAAO,gBAAmB,qBAOvD,MAAM,WAAa,aAAa,cAAc,IAAI,IAAI,qBAAsB,YAAY,GAAG,CAAC,EAAG,MAAM,EAErG,KAAK,wGAAoG,IAAM,CAC7G,UAAW,QAAQ,SAAU,CAC3B,OAAO,GACL,MAAM,SAAS,KAAK,MAAM,EAC1B,wBAAwB,KAAK,IAAI,yFACnC,EACA,OAAO,GACL,MAAM,SAAS,KAAK,OAAO,EAC3B,wBAAwB,KAAK,IAAI,0FACnC,CACF,CACF,CAAC,EAED,KAAK,+GAA2G,IAAM,CACpH,MAAM,kBAAoB,MAAM,MAAM,IAAI,EAAE,OAAQ,MAAS,UAAU,KAAK,IAAI,CAAC,EACjF,OA