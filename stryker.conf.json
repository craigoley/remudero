{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test --import tsx --import ./test/setup/tmp-hygiene.ts test/classify.test.ts test/block-reason.test.ts test/three-retries-in-three-seconds-against-a-lockout.test.ts test/session-limit-is-a-refusal-not-a-success.test.ts"
  },
  "mutate": ["src/lib/classify.ts"],
  "tsconfigFile": "tsconfig.stryker-unused.json",
  "disableTypeChecks": "{src,test}/**/*.ts",
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "concurrency": 4,
  "timeoutMS": 15000,
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json"
}
