diff --git a/learnings/ci.yaml b/learnings/ci.yaml
index 1111111..2222222 100644
--- a/learnings/ci.yaml
+++ b/learnings/ci.yaml
@@ -0,0 +1,20 @@
+- id: an-advisory-ignore-needs-the-operator-yes
+  subsystem: ci
+  lifecycle: active
+  files: [osv-scanner.toml, ".github/semgrep/**", ".github/workflows/osv-scanner*.yml", commitlint.config.mjs, .github/workflows/pr-title-lint.yml, src/lib/code-scanning-merge-policy.mjs]
+  fact: >-
+    Never add a security-advisory ignore, scanner exclusion or gate loosening without the operator's
+    explicit yes; a reachability argument is not a waiver. Read ALL comments on another session's PR
+    before pushing to it.
+  src: "PRs #12305/#12342, #12322/#12343"
+  cited: "2026-10-16"
+
+- id: a-lowered-ceiling-is-rederived-on-current-main
+  subsystem: ci
+  lifecycle: active
+  files: ["scripts/*-baseline.json"]
+  fact: >-
+    Ceiling ratchets judge each PR on its own base: re-derive a LOWERED baseline row against current
+    origin/main right before merge, or siblings that add lines red main (until W1-T9962).
+  src: "PRs #12428, #12388, #12437, #12454; W1-T9962"
+  cited: "2026-10-16"
diff --git a/learnings/architecture.yaml b/learnings/architecture.yaml
index 1111111..2222222 100644
--- a/learnings/architecture.yaml
+++ b/learnings/architecture.yaml
@@ -0,0 +1,21 @@
+- id: a-garden-fallback-cadence-is-the-poll-tick
+  subsystem: architecture
+  lifecycle: active
+  files: [src/lib/garden-registry.ts, src/lib/host-memory-admission.ts, src/lib/gardener-runtime.ts]
+  fact: >-
+    A garden's scheduled fallback cadence (`intervalFor: sameInterval`, `minIntervalMs: 0`) is the
+    60 s poll tick, never a behavioural bound; a restart seed is age since the last completion, not
+    queueing time.
+  src: "PRs #12435, #12502; W1-T9975"
+  cited: "2026-10-17"
+
+- id: depends-on-is-a-dispatch-input
+  subsystem: plan
+  lifecycle: active
+  files: ["plan/tasks.d/**", src/lib/dispatch-value.ts]
+  fact: >-
+    `depends_on` is a dispatch input: `costOfDelayContext` multiplies a score by 1 + open transitive
+    dependents, so a serial chain outranks independent P1 work. Declare it only for a real
+    dependency (until W1-T10020).
+  src: "PRs #12389, #12535; W1-T10020"
+  cited: "2026-10-17"
diff --git a/learnings/testing.yaml b/learnings/testing.yaml
index 1111111..2222222 100644
--- a/learnings/testing.yaml
+++ b/learnings/testing.yaml
@@ -0,0 +1,9 @@
+- id: a-cancelled-test-is-a-failure
+  subsystem: testing
+  lifecycle: active
+  files: [scripts/pure-test-pool.mjs, scripts/test-run.mjs, scripts/test-with-retry.mjs, scripts/pool-run-tally.mjs, scripts/preflight-author.mjs, scripts/lib/native-author-runtime.mjs, src/lib/retro-preflight.ts, src/lib/ci-friction-gardener.ts, src/lib/plan-pr-emitter.ts]
+  fact: >-
+    node:test counts a timed-out test under `# cancelled`, not `# fail`, so `# fail 0` can hide
+    tests that never finished: treat `# cancelled` > 0 as a failure.
+  src: "PR #12472"
+  cited: "2026-10-16"
